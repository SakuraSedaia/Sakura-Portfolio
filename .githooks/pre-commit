#!/bin/sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES="$(mktemp)"
trap 'rm -f "$STAGED_FILES"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$STAGED_FILES"

if command -v pnpm >/dev/null 2>&1; then
  if [ -s "$STAGED_FILES" ]; then
    xargs -0 pnpm --silent prettier --write --ignore-unknown < "$STAGED_FILES"
    xargs -0 git add -- < "$STAGED_FILES"
  fi
  pnpm --silent lint
  pnpm --silent update:sitemap
else
  if [ -s "$STAGED_FILES" ]; then
    xargs -0 npx prettier --write --ignore-unknown < "$STAGED_FILES"
    xargs -0 git add -- < "$STAGED_FILES"
  fi
  npx eslint src --ext .ts,.tsx
  node utils/update-sitemap-lastmod.mjs
fi

mkdir -p "$REPO_ROOT/public/json"
cp "$REPO_ROOT/src/data/json/projects/sacr-index.json" "$REPO_ROOT/public/json/sacr-index.json"

git add "$REPO_ROOT/public/sitemap.xml" "$REPO_ROOT/public/json/sacr-index.json"
