{
  "name": "sakura-portfolio-typescript",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite dev --configLoader runner --port 3232 --host",
    "build": "vite build --configLoader runner",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "pnpm lint --fix",
    "start": "vite start",
    "preview": "vite preview",
    "update:sitemap": "node utils/update-sitemap-lastmod.mjs",
    "setup:githooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "2.0.0-alpha.3",
    "@solidjs/vite-plugin-nitro-2": "^0.3.0",
    "@vercel/analytics": "^1.6.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.21",
    "prettier": "^3.8.3",
    "solid-js": "^1.9.5",
    "solid-markdown": "^2.1.1",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "sass": "^1.99.0"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/SakuraSedaia/Sakura-Portfolio.git"
  },
  "bugs": {
    "url": "https://codeberg.org/SakuraSedaia/Sakura-Portfolio/issues"
  },
  "homepage": "https://sakura-sedaia.com",
  "keywords": [
    "portfolio",
    "solidjs",
    "typescript",
    "codeberg"
  ],
  "author": "Sakura Sedaia",
  "description": "A portfolio website built with SolidJS and TypeScript",
  "browserslist": [
    "defaults",
    "> 0.2%",
    "last 2 versions",
    "not dead"
  ]
}
