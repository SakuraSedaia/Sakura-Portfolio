{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "routes.schema.json",
  "title": "Routes Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["main"],
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "patternProperties": {
    "^(?!\\$schema$)[A-Za-z][A-Za-z0-9_-]*$": {
      "$ref": "#/$defs/routeGroup"
    }
  },
  "$defs": {
    "routeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes"],
      "properties": {
        "basePath": {
          "type": "string",
          "default": ""
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "boolean",
          "default": false
        },
        "fileName": {
          "$ref": "#/$defs/nullableString",
          "default": null
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "default": []
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "meta": {
          "$ref": "#/$defs/routeMeta",
          "default": {}
        },
        "fallback": {
          "$ref": "#/$defs/nullableString",
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "external": {
                "const": true
              }
            },
            "required": ["external"]
          },
          "then": {
            "properties": {
              "fileName": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "external": {
                  "const": true
                }
              },
              "required": ["external"]
            }
          },
          "then": {
            "properties": {
              "fileName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "routeMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "noIndex": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "nullableString": {
      "type": ["string", "null"]
    }
  }
}
