{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wiki-routes.schema.json",
  "title": "Wiki Routes Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["basePath", "routes"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "basePath": {
      "type": "string",
      "default": "/wiki"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wikiRoute"
      }
    }
  },
  "$defs": {
    "wikiRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wikiRoute"
          },
          "default": []
        },
        "meta": {
          "$ref": "#/$defs/wikiRouteMeta",
          "default": {}
        }
      }
    },
    "wikiRouteMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "noIndex": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
